{
  "hosting": {
    "public": "dist", // Your build folder containing index.html (e.g., dist, build, or public)
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
